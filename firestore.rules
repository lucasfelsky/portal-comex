rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasCorporateEmail() {
      return isAuthenticated()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@sqquimica\\.com$');
    }

    function hasActiveStatus(status) {
      return status is string
        && status.matches('^[\\s]*[Aa][Tt][Ii][Vv][Oo][\\s]*$');
    }

    // S3 / Sprint 5.1: claims do Firebase Auth sao a UNICA fonte de role/status.
    // Fallback para `firestore.get(users/{uid})` foi removido em 2026-06-30
    // (apos confirmar via Cloud Logging que todas as requests autenticadas
    // vinham com claims). Ver [[Limitações conhecidas]] L18.
    function myRoleClaims() {
      return isAuthenticated() && 'role' in request.auth.token
        ? request.auth.token.role
        : null;
    }

    function myStatusClaims() {
      return isAuthenticated() && 'status' in request.auth.token
        ? request.auth.token.status
        : null;
    }

    function myNameClaims() {
      return isAuthenticated() && 'name' in request.auth.token
        ? request.auth.token.name
        : null;
    }

    function myProfileExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return myProfileExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    // L18: role/status vem EXCLUSIVAMENTE de claims. Sem fallback para
    // `users/{uid}` — se o usuario nao tiver claims, e' tratado como
    // sem role/sem status (e portanto bloqueado em `isApprovedUser`).
    function myRole() {
      return myRoleClaims();
    }

    function myStatus() {
      return myStatusClaims();
    }

    // myName ainda tem fallback: o nome pode estar desatualizado em claims
    // ate o proximo login, e eh usado apenas para exibicao em `updatedByName`.
    function myName() {
      return myNameClaims() != null
        ? myNameClaims()
        : (myProfileExists() ? myProfile().name : null);
    }

    function isApprovedUser() {
      return hasCorporateEmail() && hasActiveStatus(myStatus());
    }

    function isAdmin() {
      return isApprovedUser() && myRole() == 'admin';
    }

    function isLogistics() {
      return isApprovedUser() && myRole() == 'logistica';
    }

    function isPreCollectionStatus(status) {
      // Status pre-coleta: o processo ainda nao foi coletado. A logistica
      // NAO pode "voltar atras" para esses valores via collectionStatus.
      // Mantemos a lista finita (vs uma allowlist de status pos-coleta,
      // que divergiu do vocabulario real do app e causou o 1o bug de prod
      // em 2026-07-06 e o 2o em 2026-07-08 — ver Limitações conhecidas).
      return status in [
        'Aguardando agendamento de coleta',
        'Coleta Agendada',
      ];
    }

    // Correcao 2026-07-06: o `collectionStatus` ATUAL nao e' mais checado contra
    // uma allowlist hardcoded (isScheduledCollectionStatus). A unica exigencia
    // para um update da logistica e' que exista coleta agendada
    // (collectionScheduledAt) — o que garante que o processo esta no fluxo de
    // coleta. Antes, a allowlist do status atual divergia do vocabulario real
    // do app e travava a logistica com permission-denied. Ver Retomada 2026-07-06.
    //
    // Correcao 2026-07-08 (3o bug de prod, mesmo incidente do 2o): o app
    // migrou de `collectionScheduledAt` (string unica) para `collectionWindows`
    // (array de janelas multi-container, com scheduledAt por janela). Sem
    // checar o modelo novo, qualquer processo que use o schema multi-container
    // cai no permission-denied mesmo com coleta marcada. Ver
    // src/utils/collectionWindows.js#getCollectionWindows (fallback novo->legado
    // no app, mas a rule precisa aceitar os dois). Ver Retomada 2026-07-08.
    function hasScheduledCollection() {
      // Schema legado: string `collectionScheduledAt` nao-vazia.
      return (resource.data.collectionScheduledAt is string
        && resource.data.collectionScheduledAt.size() > 0)
        // Schema novo (multi-container): array `collectionWindows` com pelo
        // menos 1 janela que tenha `scheduledAt` nao-vazio.
        || (resource.data.collectionWindows is list
        && resource.data.collectionWindows.size() > 0
        && resource.data.collectionWindows[0].scheduledAt is string
        && resource.data.collectionWindows[0].scheduledAt.size() > 0);
    }

    // PR #2 do backlog (auditoria preventiva de drift, 2026-07-08): harden
    // admin create/update em 3 colecoes com `hasOnly([campos])`. Antes,
    // admin podia escrever QUALQUER campo via update direto (mesmo padrao
    // permissivo de `create`). Agora, cada colecao tem allowlist propria
    // espelhando os campos reais gravados pelo `toFirestorePayload()` /
    // `setDoc(...)` do app. Origin: L21 (allowlist de status divergente)
    // + L22 (schema legado vs novo) + auditoria preventiva 2026-07-08
    // (L16: vault desatualizada). Ver Retomada 2026-07-08 § "Auditoria
    // preventiva de drift" § "PR #2 do backlog".

    // processes: 32 campos gravados pelo `toFirestorePayload()`
    // (src/services/processesRepository.js:540-580). setDoc usado com
    // `merge: true` para create E update, entao ambos compartilham a
    // mesma allowlist. `createdById/Name/createdAt` e
    // `customsFlow/mapaFlow/operationalFields` da Colecoes.md NAO sao
    // gravados pelo app (sao campos-fantasma da vault).
    function isAdminProcessFields() {
      // No `create`, `resource.data` e' null e `diff()` lanca NullValueError.
      // No `update`, `resource.data` existe. Tratamos os 2 casos:
      // - create: checa `request.resource.data.keys()` (todas as chaves do payload).
      // - update: checa `diff().affectedKeys()` (soh o que mudou).
      // As 2 expressoes produzem o mesmo `set` de chaves (porque o app usa
      // setDoc merge:true com o payload completo). Union nao' necessario
      // porque o create NAO pode ter chaves que o update nao tem (mesmo
      // payload no app).
      // PR #3 do backlog (2026-07-08): alem do hasOnly dos 32 campos,
      // valida o SHAPE e o TAMANHO de `postReceiptImages` se o campo
      // estiver presente (ate 10 elementos). Mesmo padrao de
      // isLogisticsPostReceiptUpdate: se nao estiver no doc final,
      // dispensa a checagem; se estiver, exige list + size <= 10.
      return (resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys()
      ).hasOnly([
        'name', 'category', 'processNumber', 'destination', 'etd', 'eta',
        'etaOriginal', 'processStatus', 'containerQuantity', 'palletQuantity',
        'processNotes', 'warehouseDeliveryDateOverride', 'postReceiptNotes',
        'postReceiptImages', 'cargoReceivedAt', 'items', 'berthed', 'arrived',
        'cargoPresenceInformed', 'duimpStatus', 'parameterizationChannel',
        'collectionStatus', 'collectionScheduledAt', 'collectionWindows',
        'mapaStatus', 'mapaInspectionScheduledAt', 'dtaStatus',
        'dtaLoadingScheduledAt', 'dtaArrivalAtItajai', 'updatedById',
        'updatedByName', 'updatedAt',
      ]) && (
        !('postReceiptImages' in request.resource.data)
        || (
          request.resource.data.postReceiptImages is list
          && request.resource.data.postReceiptImages.size() <= 10
        )
      );
    }

    // announcements: campos gravados pelo
    // `announcementsRepository.js:113-126` (payload do `updateDoc`/`addDoc`).
    // `body` da Colecoes.md e' `content` no codigo, e `audience` da vault
    // nao e' gravado (campo-fantasma).
    function isAdminAnnouncementUpdate() {
      return (resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys()
      ).hasOnly([
        'title', 'content', 'channel', 'updatedAt', 'createdAt',
      ]);
    }

    // barra/current: campos gravados pelo
    // `barStatusRepository.js:97-104`. `description?` da Colecoes.md e'
    // `notes` no codigo.
    function isAdminBarUpdate() {
      return (resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys()
      ).hasOnly([
        'status', 'notes', 'updatedAt',
      ]);
    }

    function isLogisticsPostReceiptUpdate() {
      // PR #3 do backlog (auditoria preventiva de drift, 2026-07-08):
      // alem do hasOnly nos 5 campos, valida o SHAPE e o TAMANHO do
      // `postReceiptImages` no ESTADO FINAL do doc: precisa ser list
      // com no maximo 10 elementos (MAX_POST_RECEIPT_IMAGES = 10 em
      // src/utils/postReceiptImages.js). Antes, a regra de negocio
      // "max 10 imagens" era so do app, sem blindagem na rule. Agora
      // a rule t rejeita (cobre update que so mexa em `postReceiptNotes`
      // mantendo `postReceiptImages` valido, e update que adicione
      // imagens ate o teto).
      // Edge case: se `postReceiptImages` nao estiver no doc final
      // (legado, sem o campo), aceitamos (regra NAO se aplica). Se
      // estiver presente, exige is list + size <= 10. Isso evita que
      // docs legados sem o campo sejam bloqueados por essa regra.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'postReceiptNotes',
        'postReceiptImages',
        'updatedAt',
        'updatedById',
        'updatedByName',
      ]) && (
        !('postReceiptImages' in request.resource.data)
        || (
          request.resource.data.postReceiptImages is list
          && request.resource.data.postReceiptImages.size() <= 10
        )
      );
    }

    function isLogisticsCollectionStatusUpdate() {
      return hasScheduledCollection()
        && !isPreCollectionStatus(request.resource.data.collectionStatus)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'collectionStatus',
          'updatedAt',
          'updatedById',
          'updatedByName',
        ]);
    }

    function isSelfRegistration() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'Pendente'
        && request.resource.data.statusTone == 'warn';
    }

    function isAllowedSelfUserUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.statusTone == resource.data.statusTone
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'area',
          'lastAccess',
          'favoriteProcessIds',
          'notes',
          'updatedAt',
          'fcmTokens',
          'notificationPreferences',
        ])
        // F6: tokens de push — lista com teto (higiene; o backend tambem
        // remove tokens invalidos no retorno do multicast).
        && (!('fcmTokens' in request.resource.data)
          || (request.resource.data.fcmTokens is list
            && request.resource.data.fcmTokens.size() <= 10))
        // F9: preferencias de notificacao — mapa (shape fino validado no
        // client/functions; default ligado quando ausente).
        && (!('notificationPreferences' in request.resource.data)
          || request.resource.data.notificationPreferences is map);
    }

    match /announcements/{docId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdmin() && isAdminAnnouncementUpdate();
      allow delete: if isAdmin();
    }

    match /forecastSettings/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isAdmin();
    }

    match /news/{docId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isAdmin();
    }

    match /externalNews/{docId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /externalNewsDlq/{docId} {
      // DLQ do sync de RSS (L1): gravada pelo scripts/syncExternalNews.mjs
      // via service account (bypassa rules). Leitura liberada so pra admin
      // auditar falhas de feed/upsert; write fechado pra clientes.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /barra/{docId} {
      allow read: if isApprovedUser();
      allow create, update: if isAdmin() && isAdminBarUpdate();
      allow delete: if isAdmin();
    }

    match /processes/{processId} {
      allow read: if isApprovedUser();
      allow create: if isAdmin()
        && isAdminProcessFields()
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.updatedByName == myName();
      allow delete: if isAdmin();
      allow update: if (
          isAdmin()
          && isAdminProcessFields()
          && request.resource.data.updatedById == request.auth.uid
          && request.resource.data.updatedByName == myName()
        ) || (
          isLogistics()
          && request.resource.data.updatedById == request.auth.uid
          && request.resource.data.updatedByName == myName()
          && (isLogisticsPostReceiptUpdate() || isLogisticsCollectionStatusUpdate())
        );

      match /messages/{messageId} {
        allow read: if isApprovedUser();
        allow create: if isApprovedUser()
          && request.resource.data.processId == processId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.authorName == myName();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isApprovedUser() && resource.data.recipientUserId == request.auth.uid;
      allow create: if false;
      allow update: if isApprovedUser()
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if isApprovedUser()
        && resource.data.recipientUserId == request.auth.uid
        && resource.data.isRead == true;
    }

    function isAdminUserFieldsUpdate() {
      // Admin pode alterar SOMENTE estes campos em `users/{uid}`. Mudou a
      // partir de Sprint 5.1 (L18): antes, admin podia escrever qualquer
      // campo; agora, o callable `adminUpdateUserClaims` e' a unica porta
      // de entrada para role/status — escrita direta via Console/firestore
      // com outros campos (ex.: `name`, `email`, `area`) e' rejeitada.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'role',
        'status',
        'statusTone',
        'updatedAt',
        'updatedById',
        'updatedByName',
      ]);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if (isSelf(uid) && hasCorporateEmail() && isSelfRegistration())
        || isAdmin();

      // Self: update apenas de metadados (name, area, lastAccess, favorites, notes).
      // Admin: update apenas de role/status via callable (updatedById/Name obrigatorios).
      allow update: if isAllowedSelfUserUpdate(uid)
        || (isAdmin() && isAdminUserFieldsUpdate()
            && request.resource.data.updatedById == request.auth.uid
            && request.resource.data.updatedByName == myName());

      allow delete: if isAdmin();
    }

    match /userCredentials/{uid} {
      allow read, write: if false;
    }

    match /audits/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Aba de suporte (backlog 2026-07-10): usuario aprovado abre chamado
    // (create com allowlist estrita: autor = caller, status inicial 'aberto',
    // prioridade default 3, mensagem 1..4000 chars, ate 5 imagens). Admin
    // tria (update apenas de status/prioridade/resolucao). Autor le os
    // proprios chamados; admin le todos. O aviso aos admins (in-app + email)
    // sai da function `notifySupportTicketCreated` via Admin SDK.
    function isSupportTicketCreate() {
      return request.resource.data.keys().hasOnly([
        'authorId', 'authorName', 'authorEmail', 'message', 'imageUrls',
        'status', 'priority', 'createdAt', 'updatedAt',
      ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorName == myName()
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'aberto'
        && request.resource.data.priority == 3
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 5;
    }

    function isAdminSupportTicketUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'priority', 'resolvedAt', 'resolvedById', 'resolvedByName',
        'updatedAt',
      ])
        && request.resource.data.status in ['aberto', 'em_andamento', 'resolvido']
        && request.resource.data.priority is int
        && request.resource.data.priority >= 1
        && request.resource.data.priority <= 5;
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (isApprovedUser() && resource.data.authorId == request.auth.uid);
      allow create: if isApprovedUser() && isSupportTicketCreate();
      allow update: if isAdmin() && isAdminSupportTicketUpdate();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
